config/.web_auth.json
.web_auth.json

# Runtime-generated backend config directory (created by start.sh; contains copied .env and auth state)
backend/config/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
