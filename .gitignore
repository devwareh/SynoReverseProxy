lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# Log files
*.log
backend.log
frontend.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing & Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
coverage.xml
*.cover
.hypothesis/

# Docker
docker-compose.override.yml
docker-compose.override.yaml

# Temporary files
*.tmp
*.temp
*.bak
*.backup
# Any file with .backup. anywhere in its name (e.g. .web_auth.json.backup.20260218_123456).
# NOTE: intentionally broad — also covers tool-generated files like schema.backup.sql.
# That is acceptable: no legitimate tracked file in this repo contains .backup. in its name.
*.backup.*
*.old
*.orig
*.save

# Test backup files
tests/**/*.backup*
tests/**/*.enc.backup*

# Frontend build artifacts (already in frontend/.gitignore, but adding here for completeness)
frontend/build/
frontend/.pnp
frontend/.pnp.js
frontend/coverage/

# Local environment files
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Local deployment scripts (user-specific)
scripts/build-on-nas.sh

# Codex agent metadata (local-only)
AGENTS.md
CLAUDE.md
skills/
docs/plans/*
docs/GITHUB_ISSUES.md
